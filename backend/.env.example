# ─── Django ───────────────────────────────────────────────────────────────────
SECRET_KEY=cambia-esto-por-una-clave-segura
DEBUG=False
DJANGO_SETTINGS_MODULE=core.settings

# ─── Base de datos ────────────────────────────────────────────────────────────
# Dejar vacío para usar SQLite (plan free de Render)
# Poner una URL de PostgreSQL aquí si tienes una BD externa
DATABASE_URL=

# ─── Hosts y CORS ─────────────────────────────────────────────────────────────
# Reemplaza "tu-app" por el nombre real de tu servicio en Render
ALLOWED_HOSTS=tu-app.onrender.com,localhost,127.0.0.1

CORS_ALLOWED_ORIGINS=https://entregable-machine-learning.vercel.app,http://localhost:5173

CSRF_TRUSTED_ORIGINS=https://tu-app.onrender.com,https://entregable-machine-learning.vercel.app
